{
  "name": "warungpintar",
  "version": "1.0.0",
  "description": "WarungPintar: PWA offline-first untuk manajemen keuangan dan inventaris UMKM (KMM AST-PTMA 2025)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/serve-production.mjs",
    "build": "npm test && npm run build:production",
    "build:scanner": "node ./node_modules/esbuild/bin/esbuild js/barcode-scanner-entry.js --bundle --minify --format=esm --target=es2020 --outfile=js/barcode-scanner.js",
    "build:production": "node scripts/build-render-production.mjs",
    "build:staging": "node scripts/build-render-staging.mjs",
    "config:check": "node scripts/check-config.js",
    "test": "node --test"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
