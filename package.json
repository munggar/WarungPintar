{
  "name": "warungpintar",
  "version": "1.0.0",
  "description": "WarungPintar: PWA offline-first untuk manajemen keuangan dan inventaris UMKM (KMM AST-PTMA 2025)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "npx --yes serve . -l 8080",
    "build": "npm run build:scanner",
    "build:scanner": "esbuild js/barcode-scanner-entry.js --bundle --minify --format=esm --target=es2020 --outfile=js/barcode-scanner.js",
    "test": "node --test"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6"
  }
}
